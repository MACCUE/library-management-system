generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Role Enum
enum Role {
  PATRON
  LIBRARIAN
}

// 2. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PATRON)
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Genre Model
model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 4. Book Model (references Genre via genreId foreign key with @relation)
model Book {
  id        String   @id @default(uuid())
  title     String
  author    String
  genreId   String
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, author])
  @@index([genreId])
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([userId])
}
